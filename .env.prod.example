# .env.prod.example — copy to .env on the VPS and fill in real values.
#   cp .env.prod.example .env  &&  nano .env
# Used by docker-compose.prod.yml (backend + caddy) and the Postgres container.
# Keep DB_PASSWORD URL-safe (avoid @ : / ? # in it) since it goes into DATABASE_URL.

# ---- Reverse proxy / TLS (Caddy) ----
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# ---- Postgres (container) ----
DB_USER=neurospine
DB_PASSWORD=change_me_url_safe
DB_NAME=neurospine

# ---- Backend: datastores (point at compose service names) ----
DATABASE_URL=postgresql://neurospine:change_me_url_safe@postgres:5432/neurospine
REDIS_URL=redis://redis:6379

# ---- Backend: server ----
PORT=3000
JWT_SECRET=generate_a_long_random_string
SKIP_TWILIO_VALIDATION=false

# ---- Twilio ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ---- AI providers ----
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=...

# ---- Optional ----
# OPENAI_MODEL=gpt-4o
# TTS_PROVIDER=openai
# OPENAI_TTS_VOICE=alloy
# ELEVENLABS_API_KEY=
# BUSINESS_NAME=NeuroSpine Institute
# BUSINESS_TIMEZONE=America/Los_Angeles
# TRANSFER_NUMBER=+1xxxxxxxxxx
# LOG_LEVEL=info
