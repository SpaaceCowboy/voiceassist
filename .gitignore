# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment / secrets
.env
.env.*
!.env.example
!.env.prod.example

# Build output
backend/dist/
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
# ...but `logs` directories under frontend/ are SOURCE CODE (the logs dashboard
# feature: lib/logs, components/logs, app/dashboard/logs), not runtime output.
# Without this, the broad `logs/` rule above silently excludes them from the
# repo and Vercel fails with "Cannot find module '@/lib/logs/types'".
!frontend/**/logs/

# Test / coverage
coverage/
.nyc_output/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*Zone.Identifier

# Misc
*.rar
*.zip
*.tar.gz
.cache/
.turbo/
.vercel/
